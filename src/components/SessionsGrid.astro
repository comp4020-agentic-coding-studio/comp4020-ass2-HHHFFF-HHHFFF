---
/**
 * The twelve sim sessions as a chronology, matching the lectures index.
 *
 * Layout comes from the shared `.chrono` rules in src/styles/layout.css.
 * Same collection, same sort, same hrefs as the CardGrid this replaces.
 */
import { getPublishedCollection } from "astro-course-university/content";
import { withBase } from "astro-theme-university/url";
import { formatCourseDate } from "../lib/dates";
import "../styles/layout.css";

const sessions = await getPublishedCollection("sessions");
const visible = sessions.sort((a, b) => a.data.week - b.data.week);
---

<ol class="chrono">
  {
    visible.map((session) => (
      <li class="chrono-row">
        <span class="chrono-week">
          <span class="chrono-week-label">Week</span>
          <span class="chrono-week-number">{session.data.week}</span>
        </span>

        <div class="chrono-body">
          <h2 class="chrono-title">
            <a href={withBase(`/sessions/${session.id}/`)}>{session.data.title}</a>
          </h2>
          {session.data.description && <p class="chrono-description">{session.data.description}</p>}
        </div>

        <p class="chrono-meta">
          <small>{formatCourseDate(session.data.date)}</small>
        </p>
      </li>
    ))
  }
</ol>
