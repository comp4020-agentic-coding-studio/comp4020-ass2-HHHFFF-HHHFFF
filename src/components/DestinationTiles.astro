---
/**
 * The home page's closing "where to go next" section, replacing a generic
 * CardGrid+Card pair with numbered tiles that carry more editorial weight.
 * Same four destinations, same hrefs, same copy as the card grid it
 * replaces — only the markup and layout change.
 */
import { withBase } from "astro-theme-university/url";
import { sessionLabels } from "../site-config";

const tiles = [
  {
    label: "Lectures",
    href: "/lectures/",
    description:
      "The twelve weeks, from what the simplex channel takes away to what a designed language cannot fix.",
  },
  {
    label: sessionLabels.plural,
    href: "/sessions/",
    description:
      "What actually happens in the hour on frequency, week by week, and what you are expected to walk out with.",
  },
  {
    label: "Assessment",
    href: "/assessments/",
    description: "Four components, what each is worth, and what none of them mark.",
  },
  {
    label: "Glossary",
    href: "/glossary/",
    description:
      "The phrases the course holds you to, and the forms it teaches you to hear as wrong.",
  },
];
---

<ul class="tiles" aria-label="Where to go next">
  {
    tiles.map(({ label, href, description }, index) => (
      <li class="tile">
        <a href={withBase(href)}>
          <span class="tile-number">{String(index + 1).padStart(2, "0")}</span>
          <span class="tile-label">{label}</span>
          <p class="tile-description">{description}</p>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .tiles {
    display: grid;
    grid-template-columns: 1fr;
    margin: 0;
    padding: 0;
    list-style: none;
    border-block-start: 1px solid var(--at-border);
  }

  .tile {
    border-block-end: 1px solid var(--at-border);
  }

  .tile a {
    display: grid;
    grid-template-columns: 3rem 1fr;
    column-gap: var(--at-spacing-md);
    padding-block: var(--at-spacing-lg);
    color: inherit;
    text-decoration: none;
  }

  .tile a:hover,
  .tile a:focus-visible {
    background: var(--at-bg-alt);
  }

  .tile-number {
    grid-row: 1 / 3;
    color: var(--at-primary);
    font-size: 1.5rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .tile-label {
    font-size: var(--at-font-size-h3);
    font-weight: 700;
    color: var(--at-heading);
  }

  .tile-description {
    grid-column: 2;
    margin: 0.25rem 0 0;
    color: var(--at-text-secondary);
  }

  @media (min-width: 48rem) {
    .tiles {
      grid-template-columns: repeat(2, 1fr);
    }

    .tile:nth-child(odd) {
      border-inline-end: 1px solid var(--at-border);
    }

    .tile a {
      padding: var(--at-spacing-lg);
    }
  }
</style>
