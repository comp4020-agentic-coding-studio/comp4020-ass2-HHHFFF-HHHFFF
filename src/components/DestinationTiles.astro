---
/**
 * The home page's closing "where to go next" section, replacing a generic
 * CardGrid+Card pair with numbered tiles that carry more editorial weight.
 * Same four destinations, same hrefs, same copy as the card grid it
 * replaces — only the markup and layout change.
 */
import { withBase } from "astro-theme-university/url";
import { sessionLabels } from "../site-config";

const tiles = [
  {
    label: "Lectures",
    href: "/lectures/",
    description:
      "The twelve weeks, from what the simplex channel takes away to what a designed language cannot fix.",
  },
  {
    label: sessionLabels.plural,
    href: "/sessions/",
    description:
      "What actually happens in the hour on frequency, week by week, and what you are expected to walk out with.",
  },
  {
    label: "Assessment",
    href: "/assessments/",
    description: "Four components, what each is worth, and what none of them mark.",
  },
  {
    label: "Glossary",
    href: "/glossary/",
    description:
      "The phrases the course holds you to, and the forms it teaches you to hear as wrong.",
  },
];
---

<ul class="tiles" aria-label="Where to go next">
  {
    tiles.map(({ label, href, description }, index) => (
      <li class="tile">
        <a href={withBase(href)}>
          <span class="tile-number">{String(index + 1).padStart(2, "0")}</span>
          <span class="tile-label">{label}</span>
          <p class="tile-description">{description}</p>
          {/* Decorative: the label is already the accessible name of the
              link, and a screen reader announcing "right arrow" after it
              adds nothing. */}
          <span class="tile-arrow" aria-hidden="true">&rarr;</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .tiles {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--at-spacing-md);
    margin: var(--at-spacing-lg) 0 var(--at-spacing-xl);
    padding: 0;
    list-style: none;
  }

  /* Each tile is a surface rather than a ruled-off area: a border, a raised
     background, and a lift on hover. The elevation tokens are themed for
     dark mode upstream, so this does not need a second set of values. */
  .tile a {
    position: relative;
    display: grid;
    /* `auto`, not a fixed rem width: at 3rem the two-digit figures did not
       fit a 3.5rem track and broke to two lines, so "01" rendered as a 0
       stacked over a 1. Sizing the track to its content cannot get that
       wrong when the type scale moves. */
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: var(--at-spacing-md);
    padding: var(--at-spacing-lg);
    overflow: hidden;
    border: 1px solid var(--at-divider);
    border-radius: var(--at-border-radius);
    background: var(--at-bg-elevated);
    color: inherit;
    text-decoration: none;
    box-shadow: var(--at-shadow-sm);
    transition:
      background-color 0.15s,
      border-color 0.15s,
      box-shadow 0.15s,
      transform 0.15s;
  }

  .tile a:hover,
  .tile a:focus-visible {
    border-color: var(--at-primary);
    background: var(--at-accent-soft);
    box-shadow: var(--at-shadow-md);
    transform: translateY(-2px);
  }

  /* An oversized figure spanning both text rows is what stops four equal
     boxes reading as a table. Tabular numerals and `nowrap` so the four
     tracks come out the same width and a two-digit figure stays on one
     line. */
  .tile-number {
    grid-row: 1 / 3;
    color: var(--at-primary);
    font-size: 2.5rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.03em;
    line-height: 0.9;
    white-space: nowrap;
  }

  .tile-label {
    align-self: center;
    font-size: var(--at-font-size-h3);
    font-weight: 700;
    color: var(--at-heading);
  }

  .tile-description {
    grid-column: 2;
    margin: 0.35rem 0 0;
    color: var(--at-text-secondary);
  }

  .tile-arrow {
    position: absolute;
    inset-block-start: var(--at-spacing-lg);
    inset-inline-end: var(--at-spacing-lg);
    color: var(--at-primary);
    font-size: 1.25rem;
    opacity: 0.35;
    transition:
      opacity 0.15s,
      translate 0.15s;
  }

  .tile a:hover .tile-arrow,
  .tile a:focus-visible .tile-arrow {
    opacity: 1;
    translate: 0.25rem 0;
  }

  @media (min-width: 48rem) {
    .tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--at-spacing-lg);
    }

    .tile a {
      padding: var(--at-spacing-xl);
    }

    .tile-number {
      font-size: 3rem;
    }

    .tile-arrow {
      inset-block-start: var(--at-spacing-xl);
      inset-inline-end: var(--at-spacing-xl);
    }
  }

  /* The lift and the arrow slide are decoration. Anyone who has asked for
     less motion still gets the colour and shadow change. */
  @media (prefers-reduced-motion: reduce) {
    .tile a,
    .tile-arrow {
      transition: none;
    }

    .tile a:hover,
    .tile a:focus-visible {
      transform: none;
    }

    .tile a:hover .tile-arrow,
    .tile a:focus-visible .tile-arrow {
      translate: none;
    }
  }
</style>
