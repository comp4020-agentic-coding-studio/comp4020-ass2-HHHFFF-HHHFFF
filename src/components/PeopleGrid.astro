---
import { getPublishedCollection } from "astro-course-university/content";
import Card from "astro-theme-university/components/Card.astro";
import CardGrid from "astro-theme-university/components/CardGrid.astro";
import { roleLabel, roleRank } from "../lib/people";

const people = await getPublishedCollection("people");

// photoAlt rides the schema's passthrough (definePeopleCollection has no
// extension point), so it needs a cast out of the generated types.
function photoAlt(data: unknown): string | undefined {
  const alt = (data as { photoAlt?: unknown }).photoAlt;
  return typeof alt === "string" ? alt : undefined;
}

const visible = people.sort((a, b) => {
  const ra = roleRank(a.data.role);
  const rb = roleRank(b.data.role);
  if (ra !== rb) return ra - rb;
  return a.data.title.localeCompare(b.data.title);
});
---

<CardGrid columns={2}>
  {
    visible.map((person) => (
      <Card
        headingLevel="h2"
        title={person.data.title}
        href={`/people/${person.id}/`}
        image={person.data.photo ?? undefined}
        imageAlt={photoAlt(person.data)}
      >
        {roleLabel(person.data.role) && (
          <p>
            <small>{roleLabel(person.data.role)}</small>
          </p>
        )}
        <p>{person.data.description}</p>
      </Card>
    ))
  }
</CardGrid>
